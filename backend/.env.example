PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-local-password
DB_NAME=digital_evidence_chain
SESSION_SECRET=replace-with-a-long-random-development-secret
EVIDENCE_STORAGE_ROOT=./evidence-storage
# Default is 512 MiB; lower or raise this for local storage capacity.
MAX_UPLOAD_BYTES=536870912
# Metadata extraction limits and worker configuration.
MAX_ANALYSIS_BYTES=536870912
MAX_ANALYSIS_OUTPUT_BYTES=262144
ANALYSIS_TIMEOUT_MS=30000
# PYTHON_BIN=python
# PYTHON_EXTRACTOR_PATH=../forensic-service/extract_metadata.py
# Set this to the deployed frontend origin in the cloud, for example:
# FRONTEND_ORIGIN=https://app.example.com
FRONTEND_ORIGIN=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=digital_evidence_chain
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-password
NEO4J_DATABASE=neo4j
# Set these only in the shell while running npm run bootstrap-admin.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_NAME=System Administrator
# BOOTSTRAP_ADMIN_PASSWORD=use-a-long-local-password
